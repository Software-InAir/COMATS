/* ==== GLOBAL RESET ==== */
* {
    font-family: "Orbitron", "Courier New", monospace;
    font-size: 12pt;
    letter-spacing: 1px;
    color: #00ffe4;
}

/* ==== BACKGROUND ==== */
QWidget {
    background-color: #0b0c10;
}

/* ==== BUTTONS ==== */
QPushButton {
    background-color: #1f2833;
    color: #66fcf1;
    border: 2px solid #45a29e;
    border-radius: 6px;
    padding: 10px 25px;
    font-weight: bold;
    text-transform: uppercase;
    transition: all 0.3s ease-in-out;
}

/* “Moving” hover effect simulated */
QPushButton:hover {
    background-color: #0b0c10;
    color: #ffffff;
    border-color: #66fcf1;
    box-shadow: 0 0 20px 4px #66fcf1;
    padding-left: 28px;
    padding-right: 22px;
}

QPushButton:pressed {
    background-color: #45a29e;
    color: #0b0c10;
    border-style: dashed;
    box-shadow: inset 0 0 10px #c5c6c7;
    padding-left: 25px;
    padding-right: 25px;
}

/* === Small button override === */
QPushButton[class="small"] {
    min-width: 80px;
    padding: 4px 6px;
    font-size: 9.5pt;
}

/* ==== TABS ==== */
QTabBar::tab {
    background-color: #1f2833;
    color: #c5c6c7;
    border: 1px solid #45a29e;
    padding: 10px 18px;
    margin: 2px;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    font-weight: bold;
    transition: all 0.2s;
}

QTabBar::tab:selected {
    background-color: #66fcf1;
    color: #0b0c10;
    border: 2px solid #0b0c10;
}

QTabBar::tab:hover {
    background-color: #c5c6c7;
    color: #0b0c10;
    transform: scale(1.05); /* Faux motion */
}

/* ==== INPUTS ==== */
QLineEdit, QTextEdit {
    background-color: #1f2833;
    color: #00ffe4;
    border: 2px solid #45a29e;
    padding: 8px;
    border-radius: 4px;
    selection-background-color: #66fcf1;
    selection-color: #0b0c10;
}

QLineEdit:focus, QTextEdit:focus {
    border: 2px dashed #66fcf1;
    box-shadow: 0 0 10px #66fcf1;
}

/* ==== COMBO BOX ==== */
QComboBox {
    background-color: #1f2833;
    color: #c5c6c7;
    border: 2px solid #45a29e;
    border-radius: 4px;
    padding: 6px;
}

QComboBox:hover {
    background-color: #66fcf1;
    color: #0b0c10;
    border: 2px solid #0b0c10;
}

QComboBox::drop-down {
    width: 30px;
    background: #45a29e;
}

/* ==== TOOLTIP ==== */
QToolTip {
    background-color: #66fcf1;
    color: #0b0c10;
    border: 2px solid #0b0c10;
    padding: 8px;
    font-weight: bold;
    border-radius: 6px;
}

/* ==== SCROLLBARS ==== */
QScrollBar:vertical {
    background: #1f2833;
    width: 12px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background: #66fcf1;
    border-radius: 6px;
    min-height: 20px;
}

QScrollBar::handle:vertical:hover {
    background: #45a29e;
}

/* ==== LABELS ==== */
QLabel {
    color: #66fcf1;
    font-weight: bold;
    text-shadow: 0 0 4px #00ffe4;
}
