/* === BASE RESET === */
* {
    font-family: "Consolas", "Courier New", monospace;
    font-size: 10.5pt;
    color: #e0f0ff;
}

/* === GENERAL BACKGROUND === */
QWidget {
    background-color: #0d1117;
}

/* === QPushButton === */
QPushButton {
    background-color: #21262d;
    color: #e0f0ff;
    border: 1px solid #58a6ff;
    border-radius: 4px;
    padding: 6px 20px;
    min-width: 200px;
    font-size: 10pt;
    transition: all 0.2s ease;
}
QPushButton:hover {
    background-color: #30363d;
    border-color: #f472b6; /* Neon pink edge */
}
QPushButton:pressed {
    background-color: #0d1117;
    border-color: #58a6ff;
    color: #58a6ff;
}

/* === Small button override === */
QPushButton[class="small"] {
    min-width: 80px;
    padding: 4px 8px;
    font-size: 9.5pt;
}

/* === QLabel === */
QLabel {
    color: #c9d1d9;
}

/* === QLineEdit and QTextEdit === */
QLineEdit, QTextEdit {
    background-color: #161b22;
    border: 1px solid #30363d;
    border-radius: 4px;
    padding: 6px;
    color: #e6edf3;
}
QLineEdit:focus, QTextEdit:focus {
    border-color: #58a6ff;
    background-color: #0d1117;
}

/* === QComboBox === */
QComboBox {
    background-color: #21262d;
    border: 1px solid #30363d;
    border-radius: 4px;
    padding: 4px 8px;
}
QComboBox:hover {
    border-color: #f472b6;
}
QComboBox::drop-down {
    width: 20px;
    border-left: 1px solid #30363d;
}
QComboBox QAbstractItemView {
    background-color: #161b22;
    border: 1px solid #30363d;
    selection-background-color: #58a6ff;
    selection-color: #0d1117;
}

/* === QTabWidget === */
QTabWidget::pane {
    border: 1px solid #30363d;
    border-radius: 4px;
}
QTabBar::tab {
    background-color: #161b22;
    border: 1px solid #30363d;
    border-bottom: none;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    padding: 6px 12px;
    color: #8b949e;
}
QTabBar::tab:selected {
    background-color: #0d1117;
    color: #58a6ff;
    font-weight: bold;
}

/* === QScrollBar === */
QScrollBar:vertical {
    width: 10px;
    background: #21262d;
}
QScrollBar::handle:vertical {
    background: #58a6ff;
    border-radius: 5px;
}
QScrollBar::handle:vertical:hover {
    background: #f472b6;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

/* === QToolTip === */
QToolTip {
    background-color: #58a6ff;
    color: #0d1117;
    border: 1px solid #f472b6;
    padding: 6px;
    border-radius: 3px;
}
