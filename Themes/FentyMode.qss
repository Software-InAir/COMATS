/* === BASE RESET === */
* {
    font-family: "Playfair Display", serif;
    font-size: 11pt;
    color: #ffffff;
}

/* === GENERAL BACKGROUND === */
QWidget {
    background-color: #000000;
}

/* === QPushButton === */
QPushButton {
    background-color: #121212;
    color: #ffffff;
    border: 1px solid #888888;
    border-radius: 6px;
    padding: 6px 20px;
    min-width: 200px;
    font-weight: 600;
}
QPushButton:hover {
    background-color: #1f1f1f;
    border-color: #d7a8b7; /* Fenty-style rose */
}
QPushButton:pressed {
    background-color: #2a2a2a;
    border-color: #ffffff;
    color: #d7a8b7;
}

/* === Small button override === */
QPushButton[class="small"] {
    min-width: 80px;
    padding: 4px 8px;
    font-size: 10pt;
}

/* === QLabel === */
QLabel {
    color: #ffffff;
}

/* === QLineEdit and QTextEdit === */
QLineEdit, QTextEdit {
    background-color: #0d0d0d;
    border: 1px solid #666666;
    border-radius: 5px;
    padding: 6px;
    color: #ffffff;
}
QLineEdit:focus, QTextEdit:focus {
    border: 1px solid #d7a8b7;
    background-color: #1a1a1a;
}

/* === QComboBox === */
QComboBox {
    background-color: #0d0d0d;
    border: 1px solid #666666;
    border-radius: 5px;
    padding: 4px 6px;
    color: #ffffff;
}
QComboBox:hover {
    border-color: #d7a8b7;
}
QComboBox::drop-down {
    width: 20px;
    border-left: 1px solid #666666;
}
QComboBox QAbstractItemView {
    background-color: #000000;
    border: 1px solid #888888;
    selection-background-color: #2c2c2c;
    selection-color: #d7a8b7;
}

/* === QTabWidget === */
QTabWidget::pane {
    border: 1px solid #888888;
    border-radius: 5px;
}
QTabBar::tab {
    background-color: #121212;
    border: 1px solid #888888;
    border-bottom: none;
    padding: 6px 12px;
    color: #aaaaaa;
}
QTabBar::tab:selected {
    background-color: #000000;
    color: #ffffff;
    font-weight: bold;
}

/* === QScrollBar === */
QScrollBar:vertical {
    width: 10px;
    background: #121212;
}
QScrollBar::handle:vertical {
    background: #555555;
    border-radius: 4px;
}
QScrollBar::handle:vertical:hover {
    background: #d7a8b7;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

/* === QToolTip === */
QToolTip {
    background-color: #d7a8b7;
    color: #000000;
    border: 1px solid #ffffff;
    padding: 6px;
    border-radius: 4px;
    font-size: 10pt;
}
