/* === BASE RESET === */
* {
    font-family: "Staatliches";
    font-size: 11pt;
    color: #111;
}

/* === GENERAL BACKGROUND === */
QWidget {
    background-color: #f9f9f6;
}

/* === QPushButton === */
QPushButton {
    background-color: #fff;
    color: #d32f2f;
    border: 2px dashed #d32f2f;
    border-radius: 3px;
    padding: 8px 22px;
    min-width: 250px;
    text-transform: uppercase;
    letter-spacing: 1px;
    font-weight: bold;
    box-shadow: none;
    transition: all 0.2s ease-in-out;
}

QPushButton:hover {
    background-color: #d32f2f;
    color: #ffffff;
    border-style: solid;
    border-width: 2px;
    border-color: #fff;
    box-shadow: 0 0 10px #d32f2f;
    transform: scale(1.03); /* Simulated motion */
}

QPushButton:pressed {
    background-color: #a30000;
    border-color: #000000;
    color: #ffffff;
    transform: scale(0.97);
}

/* === Small button override === */
QPushButton[class="small"] {
    min-width: 80px;
    padding: 4px 8px;
    font-size: 10pt;
    border-radius: 2px;
}

/* === QLabel === */
QLabel {
    color: #111;
    font-weight: bold;
    text-transform: uppercase;
}

/* === QLineEdit and QTextEdit === */
QLineEdit, QTextEdit {
    background-color: #f4f4f4;
    border: 1px dashed #d32f2f;
    border-radius: 3px;
    padding: 6px;
    color: #111;
}

QLineEdit:focus, QTextEdit:focus {
    border: 2px solid #a30000;
    box-shadow: 0 0 6px #d32f2f;
}

/* === QComboBox === */
QComboBox {
    background-color: #f4f4f4;
    border: 1px solid #d32f2f;
    border-radius: 3px;
    padding: 5px 8px;
    color: #111;
}

QComboBox:hover {
    border-color: #a30000;
    box-shadow: 0 0 5px #d32f2f;
}

QComboBox::drop-down {
    width: 20px;
    border-left: 1px solid #d32f2f;
    background: transparent;
}

QComboBox QAbstractItemView {
    background-color: #fff;
    border: 1px solid #d32f2f;
    selection-background-color: #d32f2f;
    selection-color: #fff;
}

/* === QTabWidget === */
QTabWidget::pane {
    border: 2px solid #d32f2f;
    margin: 2px;
}

QTabBar::tab {
    background-color: #fff;
    border: 1px solid #d32f2f;
    padding: 6px 14px;
    color: #d32f2f;
    text-transform: uppercase;
    font-weight: normal;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    margin-right: 2px;
}

QTabBar::tab:hover {
    background-color: #ffecec;
    border-color: #a30000;
}

QTabBar::tab:selected {
    background-color: #d32f2f;
    color: #ffffff;
    font-weight: bold;
}

/* === QScrollBar === */
QScrollBar:vertical {
    width: 12px;
    background: #f0f0f0;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background: #d32f2f;
    border-radius: 5px;
    min-height: 20px;
}

QScrollBar::handle:vertical:hover {
    background: #a30000;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
    background: none;
}

/* === QToolTip === */
QToolTip {
    background-color: #d32f2f;
    color: #ffffff;
    border: 1px solid #000000;
    padding: 5px;
    font-size: 9.5pt;
    border-radius: 2px;
    text-transform: uppercase;
}

/* === BONUS: QGroupBox Header === */
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top center;
    padding: 4px 8px;
    background-color: #fff;
    border: 1px dashed #d32f2f;
    border-radius: 3px;
    color: #d32f2f;
    font-weight: bold;
}
