/* === BASE RESET === */
* {
    font-family: "Courier New", monospace;
    font-size: 10pt;
    color: #000000;
}

/* === GENERAL BACKGROUND === */
QWidget {
    background-color: #ffffff;
}

/* === QPushButton === */
QPushButton {
    background-color: #ffffff;
    color: #000000;
    border: 2px solid #000000;
    border-radius: 0px;
    padding: 4px 20px;
    min-width: 200px;
    font-weight: bold;
}
QPushButton:hover {
    background-color: #eeeeee;
}
QPushButton:pressed {
    background-color: #cccccc;
    color: #000000;
}

/* === Small button override === */
QPushButton[class="small"] {
    min-width: 80px;
    padding: 4px 6px;
    font-size: 9.5pt;
}

/* === QLabel === */
QLabel {
    color: #000000;
    font-weight: bold;
}

/* === QLineEdit and QTextEdit === */
QLineEdit, QTextEdit {
    background-color: #ffffff;
    border: 2px solid #000000;
    border-radius: 0px;
    padding: 4px;
    color: #000000;
}
QLineEdit:focus, QTextEdit:focus {
    background-color: #f5f5f5;
}

/* === QComboBox === */
QComboBox {
    background-color: #ffffff;
    border: 2px solid #000000;
    border-radius: 0px;
    padding: 4px 6px;
}
QComboBox:hover {
    background-color: #eeeeee;
}
QComboBox::drop-down {
    width: 20px;
    border-left: 2px solid #000000;
}
QComboBox QAbstractItemView {
    background-color: #ffffff;
    border: 1px solid #000000;
    selection-background-color: #000000;
    selection-color: #ffffff;
}

/* === QTabWidget === */
QTabWidget::pane {
    border: 2px solid #000000;
}
QTabBar::tab {
    background-color: #ffffff;
    border: 2px solid #000000;
    padding: 6px 10px;
    color: #000000;
    border-bottom: none;
}
QTabBar::tab:selected {
    background-color: #cccccc;
    font-weight: bold;
}

/* === QScrollBar === */
QScrollBar:vertical {
    width: 10px;
    background: #f0f0f0;
}
QScrollBar::handle:vertical {
    background: #000000;
}
QScrollBar::handle:vertical:hover {
    background: #444444;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

/* === QToolTip === */
QToolTip {
    background-color: #000000;
    color: #ffffff;
    border: 2px solid #000000;
    padding: 6px;
    font-weight: bold;
    border-radius: 0px;
}
