/* === BASE RESET === */
* {
    font-family: "Segoe UI", "Helvetica Neue", sans-serif;
    font-size: 11pt;
    color: #2c2c2c;
}

/* === GENERAL BACKGROUND === */
QWidget {
    background-color: #f4f4f4;
}

/* === QPushButton === */
QPushButton {
    background-color: #e2e2e2;
    color: #2c2c2c;
    border: 1px solid #b5b5b5;
    border-radius: 3px;
    padding: 4px 20px;
    min-width: 200px;
    font-size: 10pt;
}
QPushButton:hover {
    background-color: #d6f2e7;  /* subtle mint */
    border-color: #95d3b3;
}
QPushButton:pressed {
    background-color: #bfe8d4;
    border-color: #88c7a8;
}

/* === Small button override === */
QPushButton[class="small"] {
    min-width: 80px;
    padding: 4px 6px;
    font-size: 9.5pt;
}

/* === QLabel === */
QLabel {
    color: #2c2c2c;
}

/* === QLineEdit and QTextEdit === */
QLineEdit, QTextEdit {
    background-color: #ffffff;
    border: 1px solid #c0c0c0;
    border-radius: 4px;
    padding: 5px;
}
QLineEdit:focus, QTextEdit:focus {
    border: 1px solid #88c7a8;
}

/* === QComboBox === */
QComboBox {
    background-color: #ffffff;
    border: 1px solid #c0c0c0;
    border-radius: 4px;
    padding: 4px 6px;
}
QComboBox:hover {
    border-color: #88c7a8;
}
QComboBox::drop-down {
    width: 20px;
    border-left: 1px solid #c0c0c0;
}
QComboBox QAbstractItemView {
    background-color: #ffffff;
    border: 1px solid #c0c0c0;
    selection-background-color: #d6f2e7;
}

/* === QTabWidget === */
QTabWidget::pane {
    border: 1px solid #cccccc;
    border-radius: 4px;
}
QTabBar::tab {
    background-color: #e4e4e4;
    border: 1px solid #cccccc;
    border-bottom: none;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    padding: 6px 10px;
}
QTabBar::tab:selected {
    background-color: #ffffff;
    font-weight: bold;
}

/* === QScrollBar === */
QScrollBar:vertical {
    width: 10px;
    background: #efefef;
}
QScrollBar::handle:vertical {
    background: #b0b0b0;
    border-radius: 5px;
}
QScrollBar::handle:vertical:hover {
    background: #7ba18e;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

/* === QToolTip === */
QToolTip {
    background-color: #444;
    color: #ffffff;
    border: 1px solid #88c7a8;
    padding: 5px;
    border-radius: 4px;
}
